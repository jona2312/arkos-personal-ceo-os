# ============================================
# ARKOS Personal CEO OS — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
OWNER_USER_ID=uuid-from-arkos-users-table

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=EAAx...
WHATSAPP_PHONE_NUMBER_ID=1148603468328514
WHATSAPP_BUSINESS_ACCOUNT_ID=976490521542421
WHATSAPP_VERIFY_TOKEN=arkos_verify_token_change_me
AUTHORIZED_OWNER_PHONE=5411XXXX0611

# --- Security ---
ARKOS_INTERNAL_SECRET=generate_a_random_64_char_string

# --- n8n ---
N8N_BASE_URL=https://n8n.inbigfinanzas.com
N8N_WEBHOOK_PATH=/webhook/arkos-whatsapp

# --- Google (Calendar + Gmail, Fase 5+) ---
