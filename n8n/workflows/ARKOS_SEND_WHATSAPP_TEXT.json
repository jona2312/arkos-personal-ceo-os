{
  "name": "ARKOS_SEND_WHATSAPP_TEXT",
  "nodes": [
    {
      "parameters": { "path": "arkos-send-text", "httpMethod": "POST", "responseMode": "responseNode" },
      "id": "st-webhook",
      "name": "Send Text Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400],
      "webhookId": "arkos-send-text"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-arkos-secret'] }}",
              "rightValue": "={{ $env.ARKOS_INTERNAL_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "st-secret-check",
      "name": "Validate Internal Header",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 400]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={ \"error\": \"Forbidden\" }", "options": { "responseCode": 403 } },
      "id": "st-403",
      "name": "Respond 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.body.phone_number_id || $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" }, { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.body.to || $json.to }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.body ? $json.body.message : $json.message) }}\n  }\n}"
      },
      "id": "st-send",
      "name": "Send via WhatsApp API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": { "jsCode": "const result = $input.first().json;\nreturn [{ json: { success: true, message_id: result.messages ? result.messages[0]?.id : null } }];" },
      "id": "st-confirm",
      "name": "Confirm Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}", "options": { "responseCode": 200 } },
      "id": "st-respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Send Text Webhook": { "main": [[{ "node": "Validate Internal Header", "type": "main", "index": 0 }]] },
    "Validate Internal Header": { "main": [[{ "node": "Send via WhatsApp API", "type": "main", "index": 0 }], [{ "node": "Respond 403", "type": "main", "index": 0 }]] },
    "Send via WhatsApp API": { "main": [[{ "node": "Confirm Sent", "type": "main", "index": 0 }]] },
    "Confirm Sent": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "arkos" }, { "name": "tool" }, { "name": "whatsapp" }],
  "triggerCount": 1
}