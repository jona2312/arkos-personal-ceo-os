{
  "name": "ARKOS_MEMORY_SEARCH",
  "nodes": [
    {
      "parameters": {
        "path": "arkos-memory-search",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "id": "ms-webhook",
      "name": "Memory Search Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400],
      "webhookId": "arkos-memory-search"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-arkos-secret'] }}",
              "rightValue": "={{ $env.ARKOS_INTERNAL_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "ms-secret-check",
      "name": "Validate Internal Header",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Forbidden\" }",
        "options": { "responseCode": 403 }
      },
      "id": "ms-403",
      "name": "Respond 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 520]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst query = input.query || input.search_text || '';\nconst userId = input.user_id || '';\nconst limit = input.limit || 10;\n\nreturn [{ json: { query, userId, limit } }];"
      },
      "id": "ms-parse",
      "name": "Parse Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/search_memory",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"search_text\": {{ JSON.stringify($json.query) }},\n  \"p_user_id\": \"{{ $json.userId }}\",\n  \"match_count\": {{ $json.limit }}\n}"
      },
      "id": "ms-supabase",
      "name": "Search Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const query = $node['Parse Search'].json.query;\nconst results = $input.first().json;\nreturn [{ json: { results: Array.isArray(results) ? results : [], query } }];"
      },
      "id": "ms-format",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": { "responseCode": 200 }
      },
      "id": "ms-respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Memory Search Webhook": { "main": [[{ "node": "Validate Internal Header", "type": "main", "index": 0 }]] },
    "Validate Internal Header": { "main": [[{ "node": "Parse Search", "type": "main", "index": 0 }], [{ "node": "Respond 403", "type": "main", "index": 0 }]] },
    "Parse Search": { "main": [[{ "node": "Search Supabase", "type": "main", "index": 0 }]] },
    "Search Supabase": { "main": [[{ "node": "Format Results", "type": "main", "index": 0 }]] },
    "Format Results": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "arkos" }, { "name": "tool" }, { "name": "memoria" }],
  "triggerCount": 1
}